      "id": "df23d567-35ee-4ff7-af4d-7a8031814de0",
      "name": "RSS Read"
    },
    {
      "parameters": {
        "jsCode": "const text = (t) => (t || '')\n  .replace(/<[^>]*>/g, ' ')\n  .replace(/&#(\\d+);/g, (_, n) => String.fromCharCode(Number(n)))\n  .replace(/&amp;/g, '&')\n  .replace(/\\s+/g, ' ')\n  .trim();\n\nconst suche = /daten|data|analyst|statist|business intelligence|power bi|\\bbi\\b|sql|python|digitalisier|software/i;\nconst ausschluss = /senior|praktik|trainee|professur|labor|molekular|chemi/i;\nconst gesehen = new Set();\nconst ergebnis = [];\n\nfor (const item of $input.all()) {\n  const j = item.json;\n  const inhalt = text(j.content || j.contentSnippet);\n  const nimm = (muster) => { const m = inhalt.match(muster); return m ? m[1].trim() : ''; };\n  const titel = text(j.title);\n  const arbeitgeber = nimm(/Arbeitgeber:\\s*(.*?)\\s*Ort:/);\n\n  const schluessel = (titel + '|' + arbeitgeber).toLowerCase();\n  if (gesehen.has(schluessel)) continue;\n  gesehen.add(schluessel);\n\n  ergebnis.push({ json: {\n    titel,\n    arbeitgeber,\n    ort: nimm(/Ort:\\s*(.*?)\\s*Bewerbungsfrist:/),\n    bewerbungsfrist: nimm(/Bewerbungsfrist:\\s*(\\d{2}\\.\\d{2}\\.\\d{4})/),\n    veroeffentlicht: j.isoDate || j.pubDate || '',\n    link: (j.link || '').split('#')[0],\n    treffer: suche.test(titel) && !ausschluss.test(titel),\n  }});\n}\n\nreturn ergebnis;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
